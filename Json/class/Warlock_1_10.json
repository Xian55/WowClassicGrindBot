        "Requirements": [
          "!Has Pet",
          "!Spell:SPELL_IMMOLATE",
          "Mana% > MIN_MANA_SHADOWBOLT%"
        ]
      }
    ]
  },
  "Combat": {
    "Sequence": [
      {
        "Name": "Immolate",
        "Key": "4",
