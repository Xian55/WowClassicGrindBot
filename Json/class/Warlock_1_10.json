        "AfterCastWaitCastbar": true,
        "Interrupt": "TargetHealth% < MIN_HEALTH_CAST%",
        "CancelOnInterrupt": true
      },
      {
        "Name": "Shoot",
        "Key": "0",
        "Item": true,
        "Requirements": [
          "HasRangedWeapon",
          "!Shooting",
          "SpellInRange:1"
        ]
      },
      {
        "Name": "AutoAttack",
        "Requirements": [
