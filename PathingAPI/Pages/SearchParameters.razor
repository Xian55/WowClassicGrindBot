@using System.Runtime.InteropServices

@inject IJSRuntime jsRuntime

<span class="form-inline px-4">

    <!-- Continent Combo -->
    @if (string.IsNullOrEmpty(OnlyMap))
    {
        <label>Continent:</label>
        <select disabled="@IsDisabled" class="form-control" @bind="MapId">
            @foreach (var kvp in knownMapIds)
            {
                <option value="@kvp.Key">@kvp.Value</option>
            }
        </select>
    }

    <!-- From Autocomplete -->
    <label style="margin-left: 10px">From:</label>
    <MatAutocompleteList Items="@FilteredLocations"
                         TItem="string"
                         Label="From"
                         ValueChanged="OnFromChanged"
                         ShowClearButton="true"
                         NumberOfElementsInPopup="10" />

    <!-- To Autocomplete -->
    <label style="margin-left: 10px">To:</label>
    <MatAutocompleteList Items="@FilteredLocations"
                         TItem="string"
                         Label="To"
                         ValueChanged="OnToChanged"
                         ShowClearButton="true"
                         NumberOfElementsInPopup="10" />

    <!-- Search Type Combo -->
    <label style="margin-left: 10px">Search:</label>
    <select disabled="@IsDisabled" class="form-control" @bind="SearchType">
        <option value="0">Original</option>
        <option value="1">A*</option>
        <option value="2">A* avoid models</option>
    </select>

    <!-- Path jitter (yards) and its seed. Seed only matters when jitter > 0. -->
    <label style="margin-left: 10px" title="Randomly offsets each path corner by up to this many yards. 0 disables it.">Jitter:</label>
    <input type="number" min="0" max="10" step="0.5" style="width: 70px" disabled="@IsDisabled" class="form-control" @bind="Jitter" />

    <label style="margin-left: 10px" title="Seeds the jitter so a route is reproducible. Leave empty for a random seed each search.">Seed:</label>
    <input type="text" placeholder="random" style="width: 100px" disabled="@IsDisabled" class="form-control" @bind="SeedText" />
    <button type="button" title="Roll a new seed" disabled="@IsDisabled" class="form-control btn btn-secondary" @onclick="RollSeed">&#127922;</button>

    <button style="margin-left: 10px" type="button" disabled="@IsDisabled" class="form-control btn btn-primary" @onclick="Draw">
        @if (IsDisabled)
        {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        }
        Draw
    </button>

    <!-- Search Button -->
    <button style="margin-left: 10px" type="button" disabled="@IsDisabled" class="form-control btn btn-primary" @onclick="StartSearch">
        @if (IsDisabled)
        {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        }
        Search
    </button>
</span>

<style>
    /* The bar sits at the bottom of the map, so the suggestion popup has to
       open upwards or it renders off-screen. */
    .mat-autocomplete-list-popup > .mdc-list {
        position: absolute;
        bottom: 60px;
        background-color: #1e1e2e;
        color: #ffffff;
        border: 1px solid #444;
        border-radius: 4px;
    }
</style>

<script>
    showAlert = (message) => {
        alert(message);
    }
</script>

@code {

    [Parameter]
    public EventCallback<SearchParam> OnSearch { get; set; }

    [Parameter]
    public EventCallback<SearchParam> OnDraw { get; set; }

    [Parameter]
    public bool IsDisabled { get; set; }

    [Parameter]
    public string OnlyMap { get; set; }

    private float MapId { get; set; }
    private string From { get; set; }
    private string To { get; set; }
    private int SearchType { get; set; }
    private float Jitter { get; set; }
    private string SeedText { get; set; } = string.Empty;

    /// <summary>Empty or non-numeric text means "random seed" (null).</summary>
    private int? ParsedSeed =>
        int.TryParse(SeedText, out int seed) ? seed : null;

    /// <summary>
    /// Rolls a fresh seed into the visible field, so a "random" run is still
    /// reproducible: the value used is on screen and can be re-searched.
    /// </summary>
    private void RollSeed() => SeedText = Random.Shared.Next(1_000_000).ToString();

    private IEnumerable<string> FilteredLocations =>
        knownLocations.Where(l => l.Location.W == MapId).Select(l => l.Description);

    private void OnFromChanged(string value) => From = value;
    private void OnToChanged(string value) => To = value;

    private readonly List<SearchLocation> knownLocations = new();
    private readonly Dictionary<float, string> knownMapIds = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            PopulateSearchParams();

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StartSearch()
    {
        string error = string.Empty;
        if (string.IsNullOrEmpty(From)) { error += "From is required. "; }
        if (string.IsNullOrEmpty(To)) { error += "To is required. "; }

        if (!string.IsNullOrEmpty(error))
        {
            await jsRuntime.InvokeAsync<object>("showAlert", error);
            return;
        }

        SearchParam searchParameters = new()
        {
            From = knownLocations.Where(l => l.Description == this.From).FirstOrDefault(),
            To = knownLocations.Where(l => l.Description == this.To).FirstOrDefault(),
            SearchType = (SearchStrategy)this.SearchType,
            Continent = ContinentDB.IdToName[this.MapId],
            Jitter = this.Jitter,
            Seed = ParsedSeed
        };

        await OnSearch.InvokeAsync(searchParameters);
    }

    private async Task Draw()
    {
        string error = string.Empty;
        if (string.IsNullOrEmpty(From)) { error += "From is required. "; }
        if (string.IsNullOrEmpty(To)) { error += "To is required. "; }

        if (!string.IsNullOrEmpty(error))
        {
            await jsRuntime.InvokeAsync<object>("showAlert", error);
            return;
        }

        SearchParam searchParameters = new()
        {
            From = knownLocations.Where(l => l.Description == this.From).FirstOrDefault(),
            To = knownLocations.Where(l => l.Description == this.To).FirstOrDefault(),
            SearchType = (SearchStrategy)this.SearchType,
            Continent = ContinentDB.IdToName[this.MapId],
            Jitter = this.Jitter,
            Seed = ParsedSeed
        };

        await OnDraw.InvokeAsync(searchParameters);
    }

