{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Game.WowProcessInput": "Warning",
        "Core.ConfigurableInput": "Warning",
        "Core.Goals.Navigation": "Information", //Debug: spline loads/brake/walk/completed; Verbose: + per-point consume
        "BlazorServer.MdnsAdvertisingService": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Pathing": {
    "Mode": "RemoteV3", //Local - RemoteV1 - RemoteV3
    "Engine": "Navmesh", //Navmesh - SpotAStar (in-process engine for Local mode)
    "hostv1": "localhost",
    "portv1": 5001,
    "hostv3": "127.0.0.1",
    "portv3": 47111
  },
  "Process": {
    "Id": -1
  },
  "Reader": {
    "Type": "DXGI",
    "UseGpu": false
  },
  "Diagnostics": {
    "Enabled": false
  },
  "Overlay": {
    "Enabled": false,
    "ShowTargeting": false,
    "ShowSkinning": false,
    "ShowTargetVsAdd": false
  },
  // Navmesh engine tunables. Bake values change the tile cache directory;
  // Query values are applied per-request with no rebake. Defaults shown.
  "Navmesh": {
    "Bake": {
      "AgentRadius": 0.5,
      "AgentMaxClimb": 1.6,
      "WalkableSlope": 48,
      //"BakeWorkers": null, // null auto-derives from CPU count
      "MinWorldZ": { "Expansion01": -700 }
    },
    "Query": {
      "EdgeMargin": 1.5,
      "PathSpacing": 2.5,
      "CorridorTiles": 2,
      "CorridorMaxTiles": 4,
      "CorridorWiden": true,
      "SkipWidenShortRoutes": true,
      "RoadCore": 8
    }
  },
  // WASD spline follower. Only engages when paths are smoothed (Local + Navmesh)
  // and a spline is loaded; RemoteV1/V3 runs fall back to the legacy waypoint
  // follower regardless. Set Enabled=false to force the legacy follower always.
  "SplineFollower": {
    "Enabled": true
  }
}