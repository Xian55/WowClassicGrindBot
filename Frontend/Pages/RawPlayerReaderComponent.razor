@using System.Reflection

@inject IAddonReader addonReader
@inject PlayerReader PlayerReader
@inject AddonBits bits
@inject SpellInRange spellInRange
@inject BuffStatus<IPlayer> playerbuffs
@inject BuffStatus<IFocus> focusbuffs
@inject CombatLog combatLog
@inject ActionBarCostReader costReader
@inject SessionStat sessionStat
@inject GossipReader gossipReader
@inject ActionBarBits<ICurrentAction> currentAction
@inject TextReader textReader

@implements IDisposable

<div class="container">
    @RenderCard("AddonReader", "addon", addonReader)
    @RenderCard("PlayerReader", "player", PlayerReader)
    @RenderCard("Party", "party", PlayerReader.PartyDebug, RenderPartyBody())
    @RenderCard("AddonBits", "bits", bits)
    @RenderCard("CurrentAction", "currentAction", currentAction)
    @RenderCard("SpellInRange", "spell", spellInRange)
    @RenderCard("CombatLog", "combat", combatLog)
    @RenderCard("Player Buffs", "playerBuffs", playerbuffs)
    @RenderCard("Focus Buffs", "focusBuffs", focusbuffs)
    @RenderCard("Actionbar Cost Reader", "cost", costReader)
    @RenderCard("Session Stats", "session", sessionStat)
    @RenderCard("Gossip", "gossip", gossipReader)
</div>

@code {

    private readonly HashSet<string> expandedSections = new(["addon", "player", "party", "bits", "currentAction", "spell", "combat", "playerBuffs", "focusBuffs", "cost", "session", "gossip"]);

    protected override void OnInitialized()
    {
        addonReader.AddonDataChanged += OnAddonDataChanged;
    }

    public void Dispose()
    {
        addonReader.AddonDataChanged -= OnAddonDataChanged;
    }

    private void OnAddonDataChanged()
    {
        base.InvokeAsync(StateHasChanged);
    }

    private RenderFragment RenderCard(string title, string key, object obj, RenderFragment? bodyOverride = null) => builder =>
    {
        int seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "card");

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "card-header d-flex justify-content-between align-items-center");
        builder.OpenElement(seq++, "span");
        builder.AddContent(seq++, title);
        builder.CloseElement();

        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "class", "btn btn-sm btn-outline-secondary");
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => Toggle(key)));
        builder.AddContent(seq++, expandedSections.Contains(key) ? "Hide" : "Show");
        builder.CloseElement();
        builder.CloseElement();

        if (expandedSections.Contains(key))
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "card-body");
            builder.AddAttribute(seq++, "style", "padding-bottom: 0");

            if (bodyOverride is not null)
            {
                builder.AddContent(seq++, bodyOverride);
            }
            else
            {
                builder.OpenComponent<TableOfComponent>(seq++);
                builder.AddAttribute(seq++, "Obj", obj);
                builder.CloseComponent();
            }

            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private void Toggle(string key)
    {
        if (!expandedSections.Add(key))
        {
            expandedSections.Remove(key);
        }
    }

    private RenderFragment RenderPartyBody() => builder =>
    {
        int seq = 0;
        builder.OpenElement(seq++, "table");
        builder.AddAttribute(seq++, "class", "table table-bordered mb-0");

        builder.OpenElement(seq++, "thead");
        builder.OpenElement(seq++, "tr");
        builder.AddContent(seq++, (MarkupString)"<th>Member</th><th>Exists</th><th>Name</th><th>Location</th><th>In Combat</th>");
        builder.CloseElement();
        builder.CloseElement();

        builder.OpenElement(seq++, "tbody");
        foreach (var member in PlayerReader.PartyDebug)
        {
            builder.OpenElement(seq++, "tr");

            builder.OpenElement(seq++, "td");
            builder.AddContent(seq++, $"Party{member.Slot}");
            builder.CloseElement();

            builder.OpenElement(seq++, "td");
            builder.AddContent(seq++, member.Exists ? "Yes" : "No");
            builder.CloseElement();

            builder.OpenElement(seq++, "td");
            string name = textReader.PartyNames[Math.Clamp(member.Slot - 1, 0, 3)];
            builder.AddContent(seq++, string.IsNullOrWhiteSpace(name) ? (member.NameHash == 0 ? "-" : $"Hash {member.NameHash}") : name);
            builder.CloseElement();

            builder.OpenElement(seq++, "td");
            if (member.MapId == 0)
            {
                builder.AddContent(seq++, "-");
            }
            else
            {
                builder.AddContent(seq++, $"Map {member.MapId}: {member.MapX:F2}, {member.MapY:F2}");
            }
            builder.CloseElement();

            builder.OpenElement(seq++, "td");
            builder.AddContent(seq++, member.InCombat ? "Yes" : "No");
            builder.CloseElement();

            builder.CloseElement();
        }
        builder.CloseElement();

        builder.CloseElement();
    };

}
